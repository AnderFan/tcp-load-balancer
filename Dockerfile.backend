FROM gcc:14-bookworm AS builder

RUN apt-get update && apt-get install -y cmake ninja-build && rm -rf /var/lib/apt/lists/*

WORKDIR /build

COPY CMakeLists.txt .
COPY common/ ./common/
COPY src/ ./src/

RUN cmake -B build -G Ninja -DCMAKE_BUILD_TYPE=Release \
    && cmake --build build --target backend_server

FROM debian:bookworm-slim

WORKDIR /app

COPY --from=builder /build/build/backend_server /app/backend_server

EXPOSE 3491

ENTRYPOINT ["/app/backend_server"]
